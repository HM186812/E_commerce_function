datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  address   String?
  role      String   @default("USER") // "USER" | "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  nameLao     String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  nameLao       String
  description   String?
  price         Float
  originalPrice Float?
  stock         Int         @default(0)
  image         String
  images        String?     // JSON array string of additional images
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName        String
  customerPhone       String
  customerAddress     String
  customerNote        String?
  totalAmount         Float
  paymentMethod       String      @default("BCEL_ONE_QR") // BCEL_ONE_QR, CASH_ON_DELIVERY
  paymentSlipUrl      String?
  paymentSlipPublicId String?
  status              String      @default("PENDING") // PENDING, PAID, SHIPPED, COMPLETED, CANCELLED
  adminNote           String?
  telegramNotified    Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())
}

model ShopSetting {
  id                String   @id @default("default")
  shopName          String   @default("My Lao E-Commerce Shop")
  shopPhone         String   @default("020 9999 8888")
  shopAddress       String   @default("Vientiane Capital, Laos")
  bcelQrImage       String?
  bcelAccountName   String   @default("E-COMMERCE SHOP")
  bcelAccountNumber String   @default("010-12-00-12345678-001")
  telegramBotToken  String?
  telegramChatId    String?
  telegramEnabled   Boolean  @default(true)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
