# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (SQLite default for zero-setup, or PostgreSQL/MySQL)
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET=super_secret_jwt_key_lao_ecommerce_2026_dev_mode
JWT_EXPIRES_IN=7d

# Cloudinary (Optional: if empty, files will be stored safely in local /uploads directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram Bot Notification (Optional: configure to get live order alerts)
# 1. Message @BotFather on Telegram to create a bot and get TOKEN
# 2. Start your bot and send a message, then get CHAT_ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Email Notification (Nodemailer / SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lao E-Commerce <noreply@lao-ecommerce.com>"
